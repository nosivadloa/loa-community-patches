+local function BuildGoldPaymentPlan(buyer, price)
+	local backpackCoins = CountCoins(buyer)
+	local bankCoins = CountCoinsInBank(buyer)
+
+	if backpackCoins >= price then
+		return { Backpack = price, Bank = 0, Stage = "Backpack" }
+	elseif bankCoins >= price then
+		return { Backpack = 0, Bank = price, Stage = "Bank" }
+	elseif backpackCoins + bankCoins >= price then
+		return { Backpack = backpackCoins, Bank = price - backpackCoins, Stage = "Backpack" }
+	end
+
+	return nil
+end
+
+local function RefundBackpackCoins(buyer, amount)
+	if amount <= 0 then return end
+
+	local backpack = buyer:GetEquippedObject("Backpack")
+	if backpack ~= nil then
+		for _, item in pairs(backpack:GetContainedObjects() or {}) do
+			if item:GetObjVar("ResourceType") == "coins" then
+				RequestAddToStack(item, amount)
+				return
+			end
+		end
+	end
+
+	CreateObjInBackpack(buyer, "coin_purse", "legacy_vendor_bank_payment_refund", amount)
+end
