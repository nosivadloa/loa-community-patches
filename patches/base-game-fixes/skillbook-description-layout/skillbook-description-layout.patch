diff --git a/scripts/base_skill_window.lua b/scripts/base_skill_window.lua
new file mode 100644
index 0000000..14ad2b2
--- /dev/null
+++ b/scripts/base_skill_window.lua
@@ -0,0 +1,61 @@
+-- Load the native skill book into this script environment, then replace only
+-- its detail-page renderer. Cross-module globals cannot override functions
+-- owned by base_skill_window.
+require 'default:base_skill_window'
+
+function AddSkillDetail(dynamicWindow, position, pageTypeIndex)
+    local curX = (position - 1) * 312
+    local skillInfo = GetAllSkills()[pageTypeIndex]
+    if not skillInfo then return end
+
+    dynamicWindow:AddImage(curX + 188, 48, "SkillIconsFrame", 102, 102)
+
+    local skillIcon = skillInfo.Data.SkillIcon or ("Skill_" .. string.sub(skillInfo.Name, 1, -6))
+    dynamicWindow:AddImage(curX + 206, 66, skillIcon, 66, 66)
+
+    dynamicWindow:AddImage(curX + 146, 150, "Prestige_TitleHeader")
+    dynamicWindow:AddLabel(curX + 240, 153,
+        "[43240f]" .. GetSkillDisplayName(skillInfo.Name) .. "[-]",
+        146, 28, 28, "center", false, false, "Kingthings_Dynamic")
+    if skillInfo.Data.PvEOnly then
+        dynamicWindow:AddImage(curX + 114, 50, "crosscut", 36, 36)
+        dynamicWindow:AddButton(curX + 114, 50, "", "", 36, 36,
+            "This skill and its abilities affect monsters only.", "", false, "Invisible")
+    end
+    dynamicWindow:AddImage(curX + 114, 186, "Prestige_Divider", 250, 0, "Sliced")
+
+    -- Native 18pt text is ellipsized by the client for expanded descriptions.
+    -- The compact label fits all current skill text; its tooltip preserves an
+    -- additional full-text fallback for future longer descriptions.
+    local skillDescription = skillInfo.Data.Description or ""
+    dynamicWindow:AddLabel(curX + 114, 204,
+        "[412A08]" .. skillDescription .. "[-]",
+        250, 104, 14, "left", false, false, "PermianSlabSerif_Dynamic_Bold")
+    dynamicWindow:AddButton(curX + 114, 204, "", "", 250, 104,
+        skillDescription, "", false, "Invisible")
+
+    dynamicWindow:AddImage(curX + 114, 308, "Prestige_Divider", 250, 0, "Sliced")
+
+    dynamicWindow:AddSkillSlider(curX + 122, 330, skillInfo.Name,
+        GetSkillCap(this, skillInfo.Name), GetSkillMaxAttained(this, skillInfo.Name), 372)
+    dynamicWindow:AddButton(curX + 114, 314, "", "", 250, 100,
+        "[$3371]", "", false, "Invisible")
+
+    if skillInfo.Data.Abilities then
+        local curAbilityX = curX + 300
+        for _, abilityName in pairs(skillInfo.Data.Abilities) do
+            local curAction = GetPrestigeAbilityUserAction(this, nil, "Skills", abilityName)
+            dynamicWindow:AddUserAction(curAbilityX, 80, curAction, 52)
+            curAbilityX = curAbilityX + 40
+        end
+    end
+
+    local trackState = HasSkillInTracker(skillInfo.Name) and "pressed" or ""
+    dynamicWindow:AddButton(curX + 307, 51, "ToggleTrackSkill|" .. skillInfo.Name,
+        "", 22, 22, "Tracked skills appear on the game HUD.", "", false, "Track", trackState)
+
+    local favState = IsFavoriteSkill(skillInfo.Name) and "pressed" or ""
+    dynamicWindow:AddButton(curX + 327, 50, "ToggleFavorite|" .. skillInfo.Name,
+        "", 22, 22, "Favorite skills are shown on the first page of the skill book.",
+        "", false, "Star", favState)
+end
