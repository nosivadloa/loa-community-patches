+-- Create the exact cart quantity without routing through base_merchant's legacy
+-- single-purchase path. That path rechecks distance against the merchant
+-- instead of the shop's interaction anchor, and its non-stackable stock update
+-- only consumes one unit even when a larger amount is supplied.
+local function CreatePurchasedQuantity(buyer, entry)
+    local backpack = buyer:GetEquippedObject("Backpack")
+    if backpack == nil then return false end
+    local canCreate, reason = CanCreateItemInContainer(entry.template, backpack, entry.qty, true)
+    if not canCreate then
+        buyer:SystemMessage(reason)
+        return false
+    end
+
+    local templateData = GetTemplateData(entry.template)
+    local isStackable = templateData.LuaModules
+        and (templateData.LuaModules.stackable or templateData.LuaModules.coins)
+    if isStackable then
+        Create.Stack.InContainer(entry.template, backpack, entry.qty)
+    else
+        for i = 1, entry.qty do
+            Create.InContainer(entry.template, backpack)
+        end
+    end
+
+    return true
+end
+
+-- Purchase path for items with no live display object (template-only /
+-- unlimited stock).
+local function CreateFromTemplate(buyer, entry)
+    if not CreatePurchasedQuantity(buyer, entry) then return end
+    buyer:SystemMessage("You purchased " .. tostring(entry.qty) .. " " .. entry.name
+        .. " for " .. ValueToAmountStr(entry.lineTotal) .. ".", "info")
+    Merchant.DoPurchaseComplete(buyer)
+end
+
+local function FulfillLivePurchase(merchant, buyer, entry)
+    local item = entry.item
+    local tamingDiff = GetTemplateObjVar(entry.template, "TamingDifficulty")
+
+    -- Sale animals are constrained to a cart quantity of one.
+    if tamingDiff then
+        local createId = uuid() .. "CreatePet"
+        RegisterSingleEventHandler(EventType.CreatedObject, createId, function(success, objRef)
+            if success then
+                SetCreatureAsPet(objRef, buyer)
+            end
+        end)
+        CreateObj(entry.template, buyer:GetLoc(), createId)
+    elseif not CreatePurchasedQuantity(buyer, entry) then
+        return
+    end
+
+    if not item:GetObjVar("UnlimitedStock") then
+        if IsStackable(item) then
+            Merchant.UpdateStock(merchant, item, entry.qty)
+        else
+            -- Merchant.UpdateStock ignores amount for non-stackable stock, so
+            -- consume one stock unit for every item delivered.
+            for i = 1, entry.qty do
+                Merchant.UpdateStock(merchant, item, 1)
+            end
+        end
+    end
+
+    buyer:SystemMessage("You purchased " .. tostring(entry.qty) .. " " .. entry.name
+        .. " for " .. ValueToAmountStr(entry.lineTotal) .. ".", "info")
+    Merchant.DoPurchaseComplete(buyer)
+
+    local position = item:GetObjVar("StockPosition")
+    if position and not item:GetObjVar("UnlimitedStock") then
+        Merchant.RefreshSlotPrice(merchant, position)
+    end
+end
