+	GetBardingDifficulty = function(self,target)
+		if not target or not target:IsValid() then return nil end
+
+		local configuredDifficulty = tonumber(target:GetObjVar("BardingDifficulty"))
+		-- Preserve deliberately authored non-default values. Most stock
+		-- creatures inherit 100, however, so that value must be tiered from
+		-- their actual combat power instead of making chickens equal dragons.
+		if configuredDifficulty and configuredDifficulty > 0 and configuredDifficulty < 100 then
+			return configuredDifficulty
+		end
+
+		local attack = tonumber(target:GetObjVar("Attack")) or 0
+		local maximumHealth = 0
+		if GetMaxHealth then
+			local ok, value = pcall(function() return GetMaxHealth(target) end)
+			if ok then maximumHealth = tonumber(value) or 0 end
+		end
+
+		local attackDifficulty = 100
+		if attack <= 2 then
+			attackDifficulty = 10
+		elseif attack <= 8 then
+			attackDifficulty = 30
+		elseif attack <= 16 then
+			attackDifficulty = 45
+		elseif attack <= 30 then
+			attackDifficulty = 60
+		elseif attack <= 48 then
+			attackDifficulty = 80
+		end
+
+		local healthDifficulty = 100
+		if maximumHealth <= 50 then
+			healthDifficulty = 10
+		elseif maximumHealth <= 250 then
+			healthDifficulty = 30
+		elseif maximumHealth <= 600 then
+			healthDifficulty = 45
+		elseif maximumHealth <= 1200 then
+			healthDifficulty = 60
+		elseif maximumHealth <= 2200 then
+			healthDifficulty = 80
+		end
+
+		-- If an engine object does not expose either power value, retain its
+		-- configured fallback instead of accidentally treating it as harmless.
+		if attack <= 0 and maximumHealth <= 0 then
+			return configuredDifficulty or 100
+		end
+
+		return math.max(attackDifficulty, healthDifficulty)
+	end,
+
